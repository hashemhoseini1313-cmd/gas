<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.example.screenrecorder">

    <!-- 🟢 مجوزهای ضروری برای سرویس پیش‌زمینه در اندروید ۱۴ و ۱۵ -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    
    <!-- مجوزهای اختیاری در صورت نیاز به صدای میکروفون یا ذخیره فایل -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />

    <application
        android:allowBackup="true"
        android:label="ScreenRecorder"
        android:supportsRtl="true">

        <!-- 🟢 تعریف درست سرویس -->
        <service
            android:name="org.example.screenrecorder.ScreenCaptureService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

    </application>

</manifest>
